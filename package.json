{
  "name": "kickpulse-desktop",
  "version": "0.2.7",
  "private": true,
  "description": "KickPulse Desktop HUD — plays jumpscares and other real-time effects directly on screen, over any game, triggered by the same events that drive your OBS widgets.",
  "main": "dist-electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build:electron": "tsc -p electron/tsconfig.build.json",
    "build": "npm run build:electron && vite build",
    "typecheck": "tsc -p electron/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "release": "node scripts/release.js"
  },
  "build": {
    "appId": "com.kickpulse.desktop",
    "productName": "KickPulse Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": false,
    "win": {
      "icon": "assets/icon.png",
      "target": [
        {
          "target": "nsis"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "KickPulse-Desktop-Setup.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "HerbalSalad",
        "repo": "kickpulse-desktop",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.57.0",
    "obs-websocket-js": "^5.0.8",
    "qwebchannel": "^6.2.0",
    "vosk-koffi": "^1.1.1",
    "ws": "^8.18.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
